@@ -1,4 +1,5 @@
 /** Greets a name, or the world when the name is blank. */
-export function greet(name: string): string {
-  return `Hello, ${name.trim() || 'world'}!`;
+export function greet(name: string, options: { shout?: boolean } = {}): string {
+  const greeting = `Hello, ${name.trim() || 'world'}!`;
+  return options.shout ? greeting.toUpperCase() : greeting;
 }
